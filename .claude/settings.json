{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(npx supabase db push *)",
      "Bash(npx supabase db reset *)",
      "Bash(vercel *)",
      "mcp__vercel__*",
      "Edit(./supabase/migrations/**)"
    ],
    "allow": [
      "Edit(./src/**)",
      "Edit(./app/**)",
      "Edit(./components/**)",
      "Bash(npm run dev)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx next *)"
    ]
  }
}
