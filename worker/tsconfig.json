{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "../lib/env.ts",
    "../lib/database.types.ts",
    "../lib/supabase.ts",
    "../lib/pipeline.ts",
    "../lib/analytics.ts"
  ],
  "exclude": ["node_modules", "dist", "../node_modules"]
}
